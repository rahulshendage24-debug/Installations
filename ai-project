import os
import streamlit as st
from google import genai

st.set_page_config(page_title="AI Code Debugger", layout="centered")

st.title("🐞 AI Code & Error Explainer")
st.write("Paste your broken code or terminal error below to get an instant fix!")

# Read API key from environment variable or user input
api_key = os.environ.get("GEMINI_API_KEY")
if not api_key:
    api_key = st.sidebar.text_input("Enter Gemini API Key", type="password")

error_input = st.text_area(
    "Your Broken Code or Error Log:",
    height=180,
    placeholder="e.g., IndexError: list index out of range or SQL syntax error..."
)

if st.button("Fix My Bug with AI"):
    if not api_key:
        st.warning("Please provide a Gemini API Key to proceed.")
    elif not error_input.strip():
        st.warning("Please paste some error logs or code first.")
    else:
        with st.spinner("Analyzing with AI..."):
            try:
                client = genai.Client(api_key=api_key)
                prompt = f"""
                You are a senior software engineer helping a student.
                Analyze the following error or broken code snippet:
                
                {error_input}

                Provide a response formatted in Markdown:
                ### 1. What Went Wrong
                Explain the root cause in 2 simple sentences.

                ### 2. Corrected Code
                Provide the full corrected code snippet.

                ### 3. Quick Prevention Tip
                One line on how to avoid this bug in the future.
                """
                response = client.models.generate_content(
                    model='gemini-2.5-flash',
                    contents=prompt,
                )
                st.success("Analysis Complete!")
                st.markdown(response.text)
            except Exception as e:
                st.error(f"Error: {e}")


